  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "const publishedDate = new Date(now.getTime() + 3 * 60 * 60 * 1000);",
          "const rejectedDate = new Date(now.getTime() + 4 * 60 * 60 * 1000);",
          "const updateDate = new Date(now.getTime() + 5 * 60 * 60 * 1000);",
          "function pad(value) { return String(value).padStart(2, '0'); }",
          "function format(date) {",
          "  return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes()) + ':' + pad(date.getSeconds());",
          "}",
          "pm.collectionVariables.set('futureEventDate', format(publishedDate));",
          "pm.collectionVariables.set('futureRejectedEventDate', format(rejectedDate));",
          "pm.collectionVariables.set('futureUpdatedEventDate', format(updateDate));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
